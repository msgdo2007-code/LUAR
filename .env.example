# Public/server routing
PUBLIC_SITE_URL=https://luarhub.site
ALLOWED_ORIGINS=https://luarhub.site

# Supabase (serverless only; never expose the service role to browser code)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments and signing (serverless only)
PUSHINPAY_TOKEN=
LIFETIME_SIGNING_SECRET=
PAYMENT_IDEMPOTENCY_SECRET=
RATE_LIMIT_SECRET=

# Optional server-side notifications
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_LOGIN_WEBHOOK_URL=
DISCORD_PAYMENT_WEBHOOK_URL=

# Feature configuration
ACCOUNT_SYNC_V2_ENABLED=true
LIFETIME_WIDGET_LIMIT=3
